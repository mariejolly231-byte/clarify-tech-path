---
import { Image } from 'astro:assets';
import logo from '../assets/logo.webp';
import { SITE, AXES, SPECIALITE, NAV } from '../data/site';

interface Props {
  /** true = header transparent posé sur le hero sombre, devient opaque dès qu'on descend */
  transparent?: boolean;
}
const { transparent = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header
  id="site-header"
  data-transparent={transparent ? 'true' : 'false'}
  data-solid={transparent ? 'false' : 'true'}
  class="fixed inset-x-0 top-0 z-50"
>
  <div class="header-bg absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="container-sf flex h-16 items-center justify-between gap-4 md:h-[4.5rem]">
    <a href="/" class="header-fg flex shrink-0 items-center gap-2.5 rounded-full" aria-label="Summit Flow, retour à l’accueil">
      <Image src={logo} alt="" width={36} height={41} class="h-9 w-auto" loading="eager" />
      <span class="font-display text-[1.65rem] leading-none">Summit Flow</span>
    </a>

    <nav aria-label="Navigation principale" class="hidden lg:block">
      <ul class="header-fg flex items-center gap-1 text-[0.95rem]">
        <li class="relative">
          <button
            type="button"
            class="nav-link inline-flex items-center gap-1.5"
            aria-expanded="false"
            aria-controls="menu-offres"
            data-menu-trigger
          >
            Offres
            <svg class="chev h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M5 7.5l5 5 5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>
          <div id="menu-offres" class="menu-panel" data-open="false" hidden>
            <ul class="grid w-[36rem] grid-cols-2 gap-1 p-2">
              {
                AXES.map((a) => (
                  <li>
                    <a href={a.href} class="menu-item h-full" aria-current={path === a.href ? 'page' : undefined}>
                      <span class="block text-xs font-semibold uppercase tracking-[0.14em] text-teal-700">Axe {a.num}</span>
                      <span class="mt-1 block font-display text-xl text-teal-900">{a.titre}</span>
                      <span class="mt-1 block text-sm leading-snug text-ink-muted">{a.court}</span>
                    </a>
                  </li>
                ))
              }
              <li class="col-span-2 border-t border-line pt-1">
                <a href={SPECIALITE.href} class="menu-item" aria-current={path === SPECIALITE.href ? 'page' : undefined}>
                  <span class="mr-3 text-xs font-semibold uppercase tracking-[0.14em] text-teal-700">Spécialité</span>
                  <span class="font-display text-teal-900">{SPECIALITE.titre}</span>
                </a>
              </li>
            </ul>
          </div>
        </li>
        {
          NAV.map((n) => (
            <li>
              <a href={n.href} class="nav-link inline-flex items-center" aria-current={path === n.href ? 'page' : undefined}>
                {n.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href={SITE.calendly} class="btn btn-primary hidden !py-2.5 text-[0.95rem] sm:inline-flex" rel="noopener">
        Réserver 30 min
      </a>
      <button
        type="button"
        class="header-fg nav-link inline-flex items-center gap-2 lg:hidden"
        aria-expanded="false"
        aria-controls="menu-mobile"
        data-mobile-trigger
      >
        <svg class="h-5 w-5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
        </svg>
        Menu
      </button>
    </div>
  </div>

  <div id="menu-mobile" class="mobile-panel lg:hidden" data-open="false" hidden>
    <nav aria-label="Navigation mobile" class="container-sf pb-8 pt-2">
      <p class="eyebrow mb-2 text-teal-700">Offres</p>
      <ul class="mb-6 divide-y divide-line border-y border-line">
        {
          AXES.map((a) => (
            <li>
              <a href={a.href} class="block py-3.5">
                <span class="block text-xs font-semibold uppercase tracking-[0.14em] text-teal-700">Axe {a.num}</span>
                <span class="font-display text-2xl text-teal-950">{a.titre}</span>
              </a>
            </li>
          ))
        }
        <li>
          <a href={SPECIALITE.href} class="block py-3.5">
            <span class="block text-xs font-semibold uppercase tracking-[0.14em] text-teal-700">Spécialité</span>
            <span class="font-display text-2xl text-teal-950">{SPECIALITE.titre}</span>
          </a>
        </li>
      </ul>
      <ul class="mb-8 grid grid-cols-2 gap-x-4 gap-y-1">
        {
          NAV.map((n) => (
            <li>
              <a href={n.href} class="block py-2.5 text-ink">{n.label}</a>
            </li>
          ))
        }
      </ul>
      <a href={SITE.calendly} class="btn btn-dark w-full" rel="noopener">Réserver 30 min d’échange</a>
    </nav>
  </div>
</header>

<style>
  /* Fond : opaque par défaut, transparent sur le hero. Seules opacity et color bougent. */
  .header-bg {
    background: color-mix(in srgb, var(--color-paper) 92%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    box-shadow: 0 1px 0 var(--color-line);
    opacity: 1;
    transition: opacity 220ms ease;
  }
  .header-fg {
    color: var(--color-teal-950);
    transition: color 220ms ease;
  }
  #site-header[data-solid='false'] .header-bg { opacity: 0; }
  #site-header[data-solid='false'] .header-fg { color: var(--color-paper); }
  #site-header[data-menu='open'] .header-bg { opacity: 1; }
  #site-header[data-menu='open'] .header-fg { color: var(--color-teal-950); }

  .nav-link {
    border-radius: 9999px;
    padding: 0.55rem 0.85rem;
    min-height: 44px;
    transition: background-color 150ms ease;
  }
  .nav-link[aria-current='page'] { text-decoration: underline; text-underline-offset: 6px; }
  @media (hover: hover) and (pointer: fine) {
    .nav-link:hover { background-color: color-mix(in srgb, currentColor 10%, transparent); }
  }
  .chev { transition: transform 200ms var(--ease-out); }
  [aria-expanded='true'] > .chev { transform: rotate(180deg); }

  /* Menu déroulant : part du bouton (origine en haut), 180 ms ease-out, jamais depuis scale(0). */
  .menu-panel {
    position: absolute;
    left: -0.5rem;
    top: calc(100% + 0.5rem);
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: 1rem;
    box-shadow: 0 18px 40px -18px rgb(7 42 40 / 0.35);
    transform-origin: top left;
    opacity: 0;
    transform: translateY(-4px) scale(0.97);
    transition: opacity 180ms var(--ease-out), transform 180ms var(--ease-out);
  }
  .menu-panel[data-open='true'] { opacity: 1; transform: none; }
  .menu-item {
    display: block;
    border-radius: 0.75rem;
    padding: 0.85rem 1rem;
    transition: background-color 150ms ease;
  }
  .menu-item:hover, .menu-item:focus-visible { background: var(--color-paper-2); }

  .mobile-panel {
    background: var(--color-paper);
    box-shadow: 0 24px 40px -24px rgb(7 42 40 / 0.4);
    max-height: calc(100svh - 4rem);
    overflow-y: auto;
    opacity: 0;
    transform: translateY(-8px);
    transition: opacity 220ms var(--ease-out), transform 220ms var(--ease-out);
  }
  .mobile-panel[data-open='true'] { opacity: 1; transform: none; }

  @media (prefers-reduced-motion: reduce) {
    .menu-panel, .mobile-panel { transform: none !important; }
  }
</style>

<script>
  const header = document.getElementById('site-header')!;

  // 1. Header transparent sur le hero, opaque dès qu'on a quitté le haut de page.
  if (header.dataset.transparent === 'true') {
    const update = () => {
      header.dataset.solid = window.scrollY > window.innerHeight * 0.6 ? 'true' : 'false';
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
  }

  // 2. Panneaux (Offres, mobile) : ouverture animée, fermeture rapide, Échap et clic extérieur.
  function panel(trigger: HTMLButtonElement, el: HTMLElement) {
    let timer: number | undefined;
    const open = () => {
      clearTimeout(timer);
      el.hidden = false;
      trigger.setAttribute('aria-expanded', 'true');
      if (el.id === 'menu-mobile') header.dataset.menu = 'open';
      requestAnimationFrame(() => requestAnimationFrame(() => (el.dataset.open = 'true')));
    };
    const close = (focusTrigger = false) => {
      if (trigger.getAttribute('aria-expanded') !== 'true') return;
      trigger.setAttribute('aria-expanded', 'false');
      el.dataset.open = 'false';
      delete header.dataset.menu;
      // La sortie est plus rapide que l'entrée : on masque après la transition.
      timer = window.setTimeout(() => (el.hidden = true), 160);
      if (focusTrigger) trigger.focus();
    };
    trigger.addEventListener('click', () => (trigger.getAttribute('aria-expanded') === 'true' ? close() : open()));
    document.addEventListener('keydown', (e) => e.key === 'Escape' && close(true));
    document.addEventListener('click', (e) => {
      const t = e.target as Node;
      if (!el.contains(t) && !trigger.contains(t)) close();
    });
    el.addEventListener('focusout', (e) => {
      const next = (e as FocusEvent).relatedTarget as Node | null;
      if (next && !el.contains(next) && !trigger.contains(next)) close();
    });
  }

  const offres = header.querySelector<HTMLButtonElement>('[data-menu-trigger]');
  const mobile = header.querySelector<HTMLButtonElement>('[data-mobile-trigger]');
  if (offres) panel(offres, document.getElementById('menu-offres')!);
  if (mobile) panel(mobile, document.getElementById('menu-mobile')!);
</script>
