---
/**
 * Hero « L'itinéraire sur la montagne ».
 * 1. La montagne sort du brouillard et monte au scroll (effet de l'ancien site).
 * 2. Un itinéraire tracé au feutre se dessine jusqu'au sommet ; les quatre balises de la méthode
 *    apparaissent quand le tracé les atteint. L'animation raconte la méthode, elle ne décore pas.
 * Le décor est collé à l'écran (sticky), le texte défile par-dessus. Rien ne bouge au chargement :
 * le H1 et l'image sont stables, seul le scroll pilote le décor (transform et opacity uniquement).
 */
import { Image } from 'astro:assets';
import { SITE } from '../data/site';
import montagne from '../assets/montagne.webp';

// Coordonnées dans le repère de l'image (1920 × 1279). Sommet vers (980, 104).
const balises = [
  { n: 1, nom: 'Observer', x: 862, y: 792, cote: 'd' },
  { n: 2, nom: 'Clarifier', x: 742, y: 652, cote: 'g' },
  { n: 3, nom: 'Simplifier', x: 906, y: 516, cote: 'd' },
  { n: 4, nom: 'Former', x: 848, y: 392, cote: 'g' },
];
const TRACE = 'M 690 930 C 760 880, 820 840, 862 792 S 700 700, 742 652 S 930 580, 906 516 S 800 440, 848 392 S 960 260, 980 128';
---

<section class="hero relative" aria-labelledby="hero-titre" data-hero>
  <!-- Décor -->
  <div class="sticky top-0 h-svh overflow-hidden" aria-hidden="true">
    <div class="ciel absolute inset-0"></div>
    <div class="topo carte absolute -inset-[12%] text-teal-700" data-carte></div>

    <div class="montagne-wrap absolute inset-x-0 bottom-0 flex justify-center" data-montagne>
      <div class="relative w-[175vw] shrink-0 md:w-[115vw] xl:w-[1500px]">
        <Image
          src={montagne}
          alt=""
          widths={[800, 1200, 1600, 1920]}
          sizes="(min-width: 1280px) 1500px, (min-width: 768px) 115vw, 175vw"
          loading="eager"
          fetchpriority="high"
          class="block h-auto w-full"
        />
        <!-- Itinéraire : même repère que l'image, il monte avec elle -->
        <svg class="absolute inset-0 h-full w-full overflow-visible" viewBox="0 0 1920 1279" fill="none">
          <defs>
            <clipPath id="trace-clip">
              <!-- Le rectangle remonte : le tracé se découvre du bas vers le sommet -->
              <rect x="0" y="0" width="1920" height="1279" transform="translate(0 1279)" data-clip></rect>
            </clipPath>
          </defs>
          <g clip-path="url(#trace-clip)">
            <path d={TRACE} stroke="var(--color-paper)" stroke-width="11" stroke-linecap="round" opacity="0.75"></path>
            <path d={TRACE} stroke="var(--color-teal-950)" stroke-width="5" stroke-linecap="round" stroke-dasharray="3 15"></path>
          </g>
          {
            balises.map((b) => (
              <g class="balise" data-balise={b.y}>
                <circle cx={b.x} cy={b.y} r="15" fill="var(--color-paper)" stroke="var(--color-teal-950)" stroke-width="5" />
                <circle cx={b.x} cy={b.y} r="5" fill="var(--color-teal-700)" />
                <text
                  class="nom-balise"
                  x={b.cote === 'd' ? b.x + 38 : b.x - 38}
                  y={b.y + 18}
                  text-anchor={b.cote === 'd' ? 'start' : 'end'}
                >
                  {b.n}. {b.nom}
                </text>
              </g>
            ))
          }
          <!-- Sommet : le fanion -->
          <g class="balise" data-balise="130">
            <path d="M980 128 V52" stroke="var(--color-teal-950)" stroke-width="5" stroke-linecap="round"></path>
            <path d="M982 54 L1036 70 L982 90 Z" fill="var(--color-teal-700)" stroke="var(--color-teal-950)" stroke-width="4" stroke-linejoin="round"></path>
            <text class="nom-balise" x="1056" y="62">Des équipes<tspan x="1056" dy="1.05em">autonomes</tspan></text>
          </g>
        </svg>
      </div>
    </div>

    <!-- Fondu vers la section suivante -->
    <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-paper to-transparent"></div>

    <!-- Bancs de brouillard : dérivent doucement, puis se dispersent au scroll -->
    <div class="brume brume-1" data-brume="-1"></div>
    <div class="brume brume-2" data-brume="1"></div>
    <div class="brume brume-3" data-brume="-0.6"></div>
  </div>

  <!-- Contenu -->
  <div class="relative z-10 -mt-[100svh]">
    <div class="container-sf flex min-h-svh flex-col items-center pt-32 text-center md:pt-40">
      <p class="eyebrow text-teal-700">Marie Jolly · Occitanie</p>
      <h1 id="hero-titre" class="titre-hero mt-5 max-w-5xl text-teal-950">
        Des <em>équipes formées</em>,<br class="hidden sm:inline" /> des outils qui <em>bossent pour elles</em>
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-ink-muted md:text-xl">
        Formation IA et <span class="whitespace-nowrap">no-code</span>, audit et mise en place d’outils pour les PME
        industrielles d’Occitanie.
      </p>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <a href={SITE.calendly} class="btn btn-dark" rel="noopener">Réserver 30 min d’échange</a>
        <a href="#offres" class="btn btn-line">Voir les deux axes</a>
      </div>
    </div>
    <!-- Temps de montée : la montagne se dégage, l'itinéraire se trace -->
    <div class="h-[150svh]" aria-hidden="true"></div>
  </div>
</section>

<!-- Au sommet : la promesse -->
<section class="pb-24 pt-10 md:pb-32" aria-label="La promesse Summit Flow">
  <p class="promesse reveal container-sf max-w-5xl text-center text-teal-950">
    Moins de bordel organisé.<br />
    <em>Plus de flux simples</em> pour que l’industrie respire.
  </p>
</section>

<noscript>
  <style>
    .montagne-wrap { transform: translateY(var(--arrivee)) !important; }
    [data-clip] { transform: none !important; }
    .balise { opacity: 1 !important; transform: none !important; }
    .brume { display: none; }
  </style>
</noscript>

<style>
  /* clip (et non hidden) : coupe ce qui déborde sans casser le sticky */
  .hero { overflow-x: clip; }
  .ciel {
    background: linear-gradient(to bottom, var(--color-paper) 0%, #eef3f0 45%, #e6f1ee 75%, var(--color-paper) 100%);
  }
  .carte { opacity: 0.16; will-change: transform; }

  .montagne-wrap {
    /* Départ : le sommet affleure sous les boutons (le haut utile de l'image est à ~8 %).
       Arrivée : le haut de l'image se cale à 10 % de l'écran, le sommet reste sous le menu.
       Les % se rapportent à la hauteur de l'image : aucun saut au chargement. */
    --depart: calc(92% - 6svh);
    --arrivee: max(0px, calc(100% - 90svh));
    transform: translateY(var(--depart));
    will-change: transform;
  }
  @media (min-width: 768px) {
    .montagne-wrap { --depart: calc(92% - 28svh); }
  }

  .nom-balise {
    font-family: var(--font-display);
    font-size: 64px;
    fill: var(--color-teal-950);
    stroke: var(--color-paper);
    stroke-width: 12px;
    stroke-linejoin: round;
    paint-order: stroke;
  }
  @media (min-width: 768px) {
    .nom-balise { font-size: 46px; stroke-width: 9px; }
  }
  /* Les balises apparaissent quand le tracé les atteint : jamais depuis scale(0) */
  .balise {
    opacity: 0;
    transform: scale(0.92);
    transform-box: fill-box;
    transform-origin: center;
    transition: opacity 260ms var(--ease-out), transform 260ms var(--ease-out);
  }
  .balise[data-on='true'] { opacity: 1; transform: none; }

  .brume {
    position: absolute;
    left: -20%;
    right: -20%;
    height: 38svh;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(255 255 255 / 0.95), rgb(255 255 255 / 0));
    pointer-events: none;
    will-change: transform, opacity;
  }
  .brume-1 { bottom: 4svh; }
  .brume-2 { bottom: -10svh; height: 30svh; }
  .brume-3 { bottom: 18svh; height: 22svh; background: radial-gradient(closest-side, rgb(255 255 255 / 0.7), rgb(255 255 255 / 0)); }

  .titre-hero {
    font-size: clamp(2.3rem, 5.2vw, 4.6rem);
    line-height: 1.12;
  }
  .promesse {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.4vw, 3.9rem);
    line-height: 1.15;
  }

  /* Dérive lente du brouillard : décor permanent, très doux, coupé en mouvement réduit */
  @media (prefers-reduced-motion: no-preference) {
    .brume-1 { animation: derive 26s var(--ease-in-out) infinite alternate; }
    .brume-2 { animation: derive 34s var(--ease-in-out) infinite alternate-reverse; }
    .brume-3 { animation: derive 30s var(--ease-in-out) infinite alternate; }
  }
  @keyframes derive {
    from { translate: -4% 0; }
    to { translate: 4% 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .balise { transition: none; }
  }
</style>

<script>
  /**
   * Pilote le décor au scroll, sans bibliothèque (environ 1 Ko).
   * Phase 1 (0 → 45 %) : la montagne monte, le brouillard s'écarte, la carte glisse.
   * Phase 2 (30 → 88 %) : l'itinéraire se trace du bas vers le sommet, les balises s'allument.
   * On écrit transform et opacity directement sur chaque élément.
   */
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const reduit = window.matchMedia('(prefers-reduced-motion: reduce)');
  const borne = (v: number) => Math.min(1, Math.max(0, v));

  if (hero) {
    const montagne = hero.querySelector<HTMLElement>('[data-montagne]')!;
    const carte = hero.querySelector<HTMLElement>('[data-carte]')!;
    const clip = hero.querySelector<SVGRectElement>('[data-clip]')!;
    const brumes = [...hero.querySelectorAll<HTMLElement>('[data-brume]')];
    const balises = [...hero.querySelectorAll<SVGGElement>('[data-balise]')];
    const BAS = 940; // y du départ du tracé
    const HAUT = 40; // y au-dessus du fanion
    let ticking = false;

    const render = () => {
      ticking = false;
      const course = hero.offsetHeight - window.innerHeight;
      const p = reduit.matches ? 1 : borne(-hero.getBoundingClientRect().top / course);

      // Phase 1 : courbe ease-out, la montagne démarre vite puis se pose
      const e = 1 - Math.pow(1 - borne(p / 0.45), 3);
      montagne.style.transform = `translateY(calc(var(--depart) * ${(1 - e).toFixed(4)} + var(--arrivee) * ${e.toFixed(4)}))`;
      carte.style.transform = `translateY(${(-6 * e).toFixed(2)}%) scale(${(1 + 0.06 * e).toFixed(4)})`;
      brumes.forEach((b) => {
        b.style.transform = `translateX(${(Number(b.dataset.brume) * 30 * e).toFixed(2)}%)`;
        b.style.opacity = Math.max(0, 1 - e * 1.4).toFixed(3);
      });

      // Phase 2 : le rectangle de découpe remonte de BAS à HAUT
      const t = borne((p - 0.3) / 0.58);
      const y = BAS - t * (BAS - HAUT);
      clip.setAttribute('transform', `translate(0 ${y.toFixed(1)})`);
      balises.forEach((b) => (b.dataset.on = t > 0 && y <= Number(b.dataset.balise) ? 'true' : 'false'));
    };

    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(render);
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    reduit.addEventListener('change', render);
    render();
  }
</script>
