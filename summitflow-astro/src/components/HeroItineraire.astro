---
/**
 * Hero « L'itinéraire ».
 * Un décor photo collé à l'écran (sticky) avance avec le scroll : léger travelling (scale)
 * et fondu d'une étape à l'autre, comme une vidéo pilotée par le défilement.
 * Le texte, lui, défile normalement par-dessus : rien n'est animé sur le H1,
 * tout le contenu est en HTML statique (lisible sans JavaScript, par Google et par les IA).
 */
import { Picture } from 'astro:assets';
import { SITE } from '../data/site';
import chaine from '../assets/photos/chaine-pyrenees-hiver.jpg';
import couloir from '../assets/photos/couloir-vallee.jpg';
import lac from '../assets/photos/itineraire-lac.jpg';
import arete from '../assets/photos/arete-sommets.jpg';
import marie from '../assets/photos/marie-samoyede-pyrenees.jpg';

const frames = [
  { src: chaine, alt: 'Chaîne des Pyrénées enneigée vue depuis les crêtes, au départ de l’itinéraire', pos: '50% 55%' },
  { src: couloir, alt: 'Vue plongeante sur une vallée de montagne depuis un couloir rocheux', pos: '50% 45%' },
  { src: lac, alt: 'Randonneuse descendant un sentier vers un lac turquoise au pied d’un glacier', pos: '50% 62%' },
  { src: arete, alt: 'Arête rocheuse et neige au-dessus d’une mer de sommets', pos: '50% 40%' },
  { src: marie, alt: 'Marie Jolly, fondatrice de Summit Flow, avec son Samoyède en montagne', pos: '62% 35%' },
];

const etapes = [
  {
    n: '01',
    titre: 'Observer',
    texte:
      'Je viens voir comment l’information circule vraiment dans vos ateliers et vos bureaux. Pas le process officiel : celui que vos équipes vivent tous les jours.',
  },
  {
    n: '02',
    titre: 'Clarifier',
    texte:
      'On cartographie ensemble vos outils, vos fichiers et vos points de friction. On cherche le passage avant de poser le pied, et on priorise ce qui mérite vraiment d’être simplifié.',
  },
  {
    n: '03',
    titre: 'Simplifier',
    texte:
      'On allège le sac. Je reconnecte vos outils existants, je supprime les ressaisies et j’ajoute de l’IA seulement là où elle sert. Pas d’usine à gaz de plus sur le dos de vos équipes.',
  },
  {
    n: '04',
    titre: 'Former',
    texte:
      'Vos équipes repartent autonomes sur leurs outils, avec une règle simple : une info, un endroit, une version. Vous ne dépendez pas de moi à vie.',
  },
];
---

<section class="itineraire relative bg-teal-950 text-paper" aria-labelledby="hero-titre" data-itineraire>
  <!-- Décor : collé à l'écran pendant toute la montée -->
  <div class="decor sticky top-0 h-svh overflow-hidden" aria-hidden="true">
    {
      frames.map((f, i) => (
        <div class="frame absolute inset-0" data-frame={i} style={i === 0 ? '' : 'opacity:0'}>
          <Picture
            src={f.src}
            alt=""
            formats={['avif', 'webp']}
            widths={[640, 960, 1280, 1600, 2000]}
            sizes="100vw"
            quality={62}
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'low'}
            decoding={i === 0 ? 'sync' : 'async'}
            class="h-full w-full object-cover"
            style={`object-position:${f.pos}`}
          />
        </div>
      ))
    }
    <!-- Voile pour garantir la lisibilité du texte clair (contraste > 4.5:1) -->
    <div class="absolute inset-0 bg-[linear-gradient(to_top,rgb(7_42_40/0.94)_0%,rgb(7_42_40/0.72)_40%,rgb(7_42_40/0.5)_70%,rgb(7_42_40/0.55)_100%)]"></div>

    <!-- Altimètre : montre où l'on en est de l'itinéraire -->
    <div class="altimetre absolute right-6 top-1/2 hidden -translate-y-1/2 md:block lg:right-10">
      <div class="relative h-56 w-px bg-paper/25">
        <div class="jauge absolute inset-x-0 bottom-0 h-full origin-bottom bg-mint-300" style="transform:scaleY(0)"></div>
      </div>
      <ol class="absolute -right-2 top-0 flex h-56 flex-col-reverse justify-between text-xs">
        {
          ['Départ', ...etapes.map((e) => e.titre)].map((label, i) => (
            <li class="repere flex flex-row-reverse items-center gap-3" data-repere={i}>
              <span class="dot block h-4 w-4 rounded-full border border-paper/60 bg-teal-950" />
              <span class="label whitespace-nowrap text-paper/70">{label}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>

  <!-- Contenu : défile normalement par-dessus le décor -->
  <div class="relative z-10 -mt-[100svh]">
    <div class="intro container-sf flex min-h-svh flex-col justify-end pb-10 pt-24 md:pb-24 md:pt-28">
      <p class="eyebrow mb-4 max-w-xl text-mint-300 md:mb-5">
        Perdus dans l’IA et les nouveaux outils, comme dans un brouillard de montagne&nbsp;?
      </p>
      <h1 id="hero-titre" class="max-w-4xl text-[2rem] font-semibold sm:text-5xl lg:text-[4rem]">
        Formation IA et <span class="whitespace-nowrap">no-code</span>, audit et mise en place d’outils pour les PME industrielles d’Occitanie
      </h1>
      <p class="mt-5 max-w-2xl text-paper/90 md:mt-6 md:text-xl">
        {SITE.promesse} Ingénieure industrielle passée par dix ans d’aéronautique, je vous aide à alléger vos outils et
        vos process, sur le terrain.
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href={SITE.calendly} class="btn btn-primary" rel="noopener">Réserver 30 min d’échange</a>
        <a href="#offres" class="btn btn-ghost">Voir les offres</a>
      </div>
      <p class="indice mt-8 flex md:mt-14 items-center gap-3 text-sm text-paper/75">
        <svg class="fleche h-5 w-5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M10 3v13m0 0l-5-5m5 5l5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        Faites défiler : on monte ensemble, étape par étape.
      </p>
    </div>

    <div class="container-sf">
      <h2 class="sr-only">La méthode Summit Flow en quatre étapes</h2>
      <ol class="pb-[30svh]">
        {
          etapes.map((e, i) => (
            <li class:list={['etape flex min-h-[90svh] items-center', i % 2 === 1 && 'md:justify-end md:pr-16 lg:pr-20']}>
              <div class="reveal max-w-md rounded-2xl bg-teal-950/70 p-7 ring-1 ring-paper/15 backdrop-blur-md md:p-9">
                <p class="font-display text-sm font-semibold tracking-[0.2em] text-mint-300">ÉTAPE {e.n}</p>
                <h3 class="mt-2 text-3xl font-semibold md:text-4xl">{e.titre}</h3>
                <p class="mt-4 text-paper/90">{e.texte}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .frame { will-change: opacity, transform; }
  .frame :global(img) { transform-origin: 50% 60%; }
  .repere .dot { transition: background-color 200ms ease, border-color 200ms ease; }
  .repere .label { transition: color 200ms ease; }
  .repere[data-actif='true'] .dot { background: var(--color-mint-300); border-color: var(--color-mint-300); }
  .repere[data-actif='true'] .label { color: var(--color-paper); }

  @media (prefers-reduced-motion: no-preference) {
    .fleche { animation: descend 1.6s var(--ease-in-out) infinite; }
  }
  @keyframes descend {
    0%, 100% { transform: translateY(0); opacity: 0.6; }
    50% { transform: translateY(4px); opacity: 1; }
  }
</style>

<script>
  /**
   * Pilote le décor au scroll. Environ 1 Ko, sans bibliothèque.
   * On écrit directement opacity et transform sur chaque calque (pas de variable CSS héritée,
   * pour éviter de recalculer les styles de tous les enfants).
   */
  const section = document.querySelector<HTMLElement>('[data-itineraire]');
  const reduit = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (section) {
    const frames = [...section.querySelectorAll<HTMLElement>('.frame')];
    const imgs = frames.map((f) => f.querySelector('img'));
    const jauge = section.querySelector<HTMLElement>('.jauge');
    const reperes = [...section.querySelectorAll<HTMLElement>('.repere')];
    const n = frames.length;
    let ticking = false;

    // Panneaux de texte : intro + 4 étapes. Chaque calque photo correspond à un panneau.
    const panneaux = [section.querySelector<HTMLElement>('.intro')!, ...section.querySelectorAll<HTMLElement>('.etape')];

    const render = () => {
      ticking = false;
      // Position continue : quel panneau occupe le centre de l'écran (0 = intro, n-1 = dernière étape)
      const centre = window.innerHeight / 2;
      const centres = panneaux.map((el, k) => {
        const r = el.getBoundingClientRect();
        return k === 0 ? r.top + window.innerHeight / 2 : r.top + r.height / 2;
      });
      let pos = 0;
      for (let k = 0; k < n - 1; k++) {
        if (centre >= centres[k]) pos = k + Math.min(1, (centre - centres[k]) / (centres[k + 1] - centres[k]));
      }
      pos = Math.min(n - 1, Math.max(0, pos));
      const actif = Math.round(pos);

      frames.forEach((frame, i) => {
        // Fondu enchaîné court, juste avant que le panneau suivant n'arrive au centre
        const d = pos - i;
        const opacity = i === 0 ? 1 : Math.min(1, Math.max(0, (d + 0.3) / 0.3));
        frame.style.opacity = String(opacity);
        // Travelling : la photo active avance doucement (1.0 → 1.08) jusqu'à l'étape suivante.
        // À l'arrivée (pos = 0) l'image LCP reste à l'échelle 1 : aucun saut au chargement.
        if (!reduit.matches && imgs[i]) {
          const local = Math.min(1, Math.max(0, d + 0.3));
          imgs[i]!.style.transform = local > 0 ? `scale(${(1 + local * 0.08).toFixed(4)})` : '';
        }
      });

      if (jauge) jauge.style.transform = `scaleY(${(pos / (n - 1)).toFixed(4)})`;
      reperes.forEach((r, i) => (r.dataset.actif = i <= actif ? 'true' : 'false'));
    };

    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(render);
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    reduit.addEventListener('change', () => {
      imgs.forEach((img) => img && (img.style.transform = ''));
      render();
    });
    render();
  }
</script>
