---
import { SITE, AXES, SPECIALITE, NAV } from '../data/site';
const offres = [...AXES.map((a) => ({ href: a.href, titre: a.titre })), SPECIALITE];
const annee = new Date().getFullYear();
---

<footer class="bg-teal-950 text-paper/85">
  <div class="container-sf grid gap-10 py-16 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <p class="font-display text-lg font-semibold tracking-[0.08em] text-paper">SUMMIT FLOW</p>
      <p class="mt-3 max-w-sm">{SITE.promesse}</p>
      <p class="mt-4 text-sm text-paper/70">Formation no-code et IA, audit et mise en place d’outils pour PME industrielles. Occitanie, et partout en France à distance.</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={SITE.calendly} class="btn btn-primary" rel="noopener">Réserver 30 min</a>
        <a href={SITE.linkedin} class="btn btn-ghost" rel="noopener">LinkedIn</a>
      </div>
    </div>
    <nav aria-label="Offres">
      <p class="eyebrow mb-4 text-mint-300">Offres</p>
      <ul class="space-y-2.5">{offres.map((o) => <li><a href={o.href} class="hover:text-paper hover:underline underline-offset-4">{o.titre}</a></li>)}</ul>
    </nav>
    <nav aria-label="Summit Flow">
      <p class="eyebrow mb-4 text-mint-300">Summit Flow</p>
      <ul class="space-y-2.5">
        {NAV.map((n) => <li><a href={n.href} class="hover:text-paper hover:underline underline-offset-4">{n.label}</a></li>)}
        <li><a href={`mailto:${SITE.email}`} class="hover:text-paper hover:underline underline-offset-4">{SITE.email}</a></li>
      </ul>
    </nav>
  </div>
  <div class="border-t border-paper/10">
    <div class="container-sf flex flex-wrap justify-between gap-4 py-6 text-sm text-paper/65">
      <p>© {annee} Summit Flow, Marie Jolly</p>
      <ul class="flex gap-5">
        <li><a href="/mentions-legales" class="hover:underline underline-offset-4">Mentions légales</a></li>
        <li><a href="/politique-confidentialite" class="hover:underline underline-offset-4">Politique de confidentialité</a></li>
      </ul>
    </div>
  </div>
</footer>
