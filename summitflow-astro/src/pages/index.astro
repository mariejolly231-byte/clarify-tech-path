---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import HeroItineraire from '../components/HeroItineraire.astro';
import Certifications from '../components/Certifications.astro';
import { SITE, AXES } from '../data/site';
import chaine from '../assets/photos/chaine-pyrenees-hiver.jpg';
import marieSommet from '../assets/photos/marie-chiens-sommet.jpg';

const logos = import.meta.glob<{ default: ImageMetadata }>('../assets/partners/*.{png,svg}', { eager: true });
const partenaires: Record<string, string> = {
  'cci-toulouse': 'CCI Toulouse Haute-Garonne',
  'ecole-cube': 'École Cube',
  senza: 'Senza Formations',
  numericoach: 'Numericoach',
  'gers-distribution': 'Gers Production Distribution',
  'bge-sud-ouest': 'BGE Sud-Ouest',
  'treso-numerique': 'La Tréso Numérique',
  'sud-formadia': 'Sud Formadia',
  'the-intelligence-academy': 'The Intelligence Academy',
  'creai-idf': 'CREAI Île-de-France',
  slangues: 'S Langues',
};
const listeLogos = Object.entries(logos)
  .map(([path, mod]) => {
    const slug = path.split('/').pop()!.replace(/\.(png|svg)$/, '');
    return { src: mod.default, nom: partenaires[slug] ?? slug };
  })
  .sort((a, b) => a.nom.localeCompare(b.nom));

// Préchargement de l'image LCP du hero (mêmes réglages que le <Picture> du hero).
const lcp = await getImage({ src: chaine, format: 'avif', widths: [640, 960, 1280, 1600, 2000], quality: 62 });

const bordel = [
  { titre: 'Des fichiers qui se contredisent', texte: 'Plusieurs versions du même tableur, des chiffres qui ne collent plus, et personne ne sait laquelle fait foi.' },
  { titre: 'Des ressaisies tous les jours', texte: 'Les mêmes informations recopiées d’un logiciel à l’autre, avec leur lot d’erreurs.' },
  { titre: 'Des décisions au ressenti', texte: 'L’info fiable n’arrive jamais au bon moment, alors on pilote à l’instinct.' },
  { titre: 'Du temps perdu à chercher', texte: 'Mails, dossiers partagés, ERP, drive : retrouver une donnée devient un projet en soi.' },
  { titre: 'Des outils payés, mais contournés', texte: 'Des licences, des fonctionnalités ignorées et des équipes qui gardent leur Excel à côté.' },
  { titre: 'Tout repose sur deux personnes', texte: 'Les process vivent dans quelques têtes. Le jour où elles partent en congé, tout ralentit.' },
];

const projets = [
  {
    nom: 'QualAgent',
    secteur: 'Sous-traitance aéronautique et automobile',
    texte: 'Un agent qui aide à préparer et vérifier les livrables APQP, AS9100 et PPAP, construit avec Make, l’API Claude, Notion et Bubble.',
  },
  {
    nom: 'Hargassner France',
    secteur: 'Grossiste, bois-énergie',
    texte: 'Une application de suivi des interventions et du stock de pièces, pensée pour le responsable technique et les techniciens terrain.',
  },
  {
    nom: 'TraceSafe Agro',
    secteur: 'Agroalimentaire',
    texte: 'Une preuve de concept de traçabilité, avec Airtable et Lovable, pour remplacer le suivi papier par une donnée consultable.',
  },
];

const temoignages = [
  { nom: 'Guillaume', role: 'Gérant de société, secteur énergie', texte: 'Les solutions proposées sont concrètes, adaptées aux besoins réels de notre entreprise et faciles à mettre en place. Un vrai partenaire de confiance pour intégrer l’IA de manière efficace et stratégique.' },
  { nom: 'Alice', role: 'Collaboratrice dans l’industrie aéronautique', texte: 'Une nécessité de se faire accompagner par une personne compétente comme Marie pour maîtriser l’IA. Ravie des services de Summit Flow.' },
  { nom: 'Sonia', role: 'Kinésithérapeute en secteur de montagne', texte: 'On a fait un rendez-vous où elle a posé beaucoup de questions pour cibler mes besoins et les solutions à mettre en place. Elle est très à l’écoute et fait un bon suivi.' },
  { nom: 'Emeline Bouchard', role: 'Participante atelier no-code', texte: 'Elle est pédagogue et se met au niveau de ses apprenants pour leur faire comprendre des concepts parfois éloignés de notre réalité.' },
];

const faq = [
  {
    q: 'Par où commencer si je ne sais pas ce qui peut être automatisé ?',
    r: 'Par un échange de 30 minutes, gratuit. Vous me décrivez ce qui vous fait perdre du temps, je vous dis honnêtement si un audit, une automatisation ou une formation a du sens, et dans quel ordre. Parfois la bonne réponse est de supprimer un fichier, pas d’ajouter un outil.',
  },
  {
    q: 'Faut-il changer d’ERP ou de logiciels ?',
    r: 'Rarement. Je pars de vos outils existants et je les fais mieux communiquer. On n’ajoute un outil que s’il retire du travail à vos équipes, jamais pour suivre une mode.',
  },
  {
    q: 'Je ne suis pas technique, est-ce un problème ?',
    r: 'Non. Mon rôle est de traduire vos besoins métier en solutions simples. Vous décrivez votre terrain, je m’occupe de la technique, et je forme ensuite vos équipes pour qu’elles gardent la main.',
  },
  {
    q: 'Et la confidentialité de nos données ?',
    r: 'Chaque solution est pensée avec vous : où sont stockées les données, qui y accède, quels outils d’IA sont acceptables pour vos clients donneurs d’ordre. Le cadre RGPD et l’AI Act font partie de l’audit et des formations.',
  },
  {
    q: 'Combien de temps dure un projet ?',
    r: 'Cela dépend du périmètre. Un audit se mène généralement en quelques jours répartis sur deux à trois semaines. Une automatisation ciblée prend de une à quelques semaines. Je vous donne une estimation précise après l’échange de cadrage, pas avant.',
  },
  {
    q: 'Travaillez-vous uniquement en Occitanie ?',
    r: 'Je suis basée au sud de Toulouse et je me déplace volontiers en Occitanie pour observer le terrain. Pour le reste de la France, le travail se fait à distance, avec des déplacements ponctuels si le projet le demande.',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.r } })),
};
---

<Base
  title="Formation IA, audit et outils no-code PME | Summit Flow"
  description="Formation IA et no-code, audit et mise en place d’outils pour les PME industrielles d’Occitanie, par une ingénieure passée par l’aéronautique."
  jsonLd={[faqLd]}
  heroSombre
>
  <link slot="head" rel="preload" as="image" type="image/avif" imagesrcset={lcp.srcSet.attribute} imagesizes="100vw" fetchpriority="high" />

  <HeroItineraire />

  <!-- Le bordel organisé -->
  <section class="py-24 md:py-32" aria-labelledby="bordel-titre">
    <div class="container-sf">
      <div class="max-w-2xl">
        <p class="eyebrow text-teal-700">Le point de départ</p>
        <h2 id="bordel-titre" class="mt-3 text-3xl font-semibold text-teal-950 md:text-5xl">Le bordel organisé, vous connaissez ?</h2>
        <p class="mt-5 text-lg text-ink-muted">
          Ce n’est la faute de personne. C’est un système qui s’est installé, un fichier après l’autre, un outil après l’autre.
          Et on finit par croire que c’est normal dans l’industrie. Ça ne l’est pas.
        </p>
      </div>
      <ul class="mt-14 grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
        {
          bordel.map((b) => (
            <li class="reveal bg-paper p-7">
              <h3 class="text-lg font-semibold text-teal-950">{b.titre}</h3>
              <p class="mt-2 text-ink-muted">{b.texte}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Offres -->
  <section id="offres" class="bg-paper-2 py-24 md:py-32" aria-labelledby="offres-titre">
    <div class="container-sf">
      <div class="max-w-2xl">
        <p class="eyebrow text-teal-700">Les offres</p>
        <h2 id="offres-titre" class="mt-3 text-3xl font-semibold text-teal-950 md:text-5xl">Deux façons de travailler ensemble</h2>
        <p class="mt-5 text-lg text-ink-muted">
          Soit vos équipes apprennent à utiliser l’IA et le no-code elles-mêmes. Soit je regarde votre terrain et je mets en
          place les outils qui allègent le sac. Souvent, on finit par faire les deux.
        </p>
      </div>
      <ul class="mt-14 grid gap-5 md:grid-cols-2">
        {
          AXES.map((a) => (
            <li class="reveal">
              <a href={a.href} class="carte flex h-full flex-col rounded-3xl border border-line bg-paper p-8 md:p-10">
                <span class="font-sans text-[0.8rem] font-semibold uppercase tracking-[0.2em] text-teal-700">Axe {a.num}</span>
                <h3 class="mt-3 text-3xl font-semibold text-teal-950 md:text-4xl">{a.titre}</h3>
                <p class="mt-4 text-lg text-ink-muted">{a.court}</p>
                <p class="mt-6 text-sm"><span class="font-semibold text-teal-950">Pour :</span> <span class="text-ink-muted">{a.pour}</span></p>
                <ul class="mt-6 flex-1 space-y-3 border-t border-line pt-6">
                  {a.contenu.map((c) => (
                    <li class="flex gap-3">
                      <svg class="mt-1 h-4 w-4 shrink-0 text-teal-700" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10.5l4 4 8-9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                      <span>{c}</span>
                    </li>
                  ))}
                </ul>
                <p class="mt-6 text-sm text-ink-muted">{a.note}</p>
                <span class="mt-6 inline-flex items-center gap-2 font-medium text-teal-800">
                  Découvrir l’axe {a.num}
                  <svg class="fleche-carte h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h12m0 0l-5-5m5 5l-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      <a href="/sous-traitants-aeronautiques" class="carte reveal mt-5 grid gap-6 rounded-2xl bg-teal-900 p-8 text-paper md:grid-cols-[1fr_auto] md:items-center md:p-10">
        <div>
          <p class="eyebrow text-mint-300">Spécialité · Sous-traitants aéronautiques</p>
          <h3 class="mt-3 text-2xl font-semibold md:text-3xl">APQP, AS9100, PPAP : j’ai passé dix ans de ce côté du dossier</h3>
          <p class="mt-3 max-w-2xl text-paper/85">
            Plans de surveillance, dossiers de premier article, revues de conformité : je sais ce que vos donneurs d’ordre
            attendent et ce que ces livrables coûtent à vos équipes qualité quand tout passe par Excel et par mail.
          </p>
        </div>
        <span class="btn btn-primary justify-self-start">Voir l’accompagnement</span>
      </a>
    </div>
  </section>

  <!-- Preuves -->
  <section class="py-24 md:py-32" aria-labelledby="projets-titre">
    <div class="container-sf">
      <div class="max-w-2xl">
        <p class="eyebrow text-teal-700">Sur le terrain</p>
        <h2 id="projets-titre" class="mt-3 text-3xl font-semibold text-teal-950 md:text-5xl">Des projets réels, pas des promesses</h2>
        <p class="mt-5 text-lg text-ink-muted">Quelques itinéraires déjà parcourus avec des entreprises qui avaient, elles aussi, un sac trop lourd.</p>
      </div>
      <ul class="mt-14 grid gap-5 md:grid-cols-3">
        {
          projets.map((p) => (
            <li class="reveal rounded-2xl border border-line p-7">
              <p class="text-sm text-ink-muted">{p.secteur}</p>
              <h3 class="mt-2 text-xl font-semibold text-teal-950">{p.nom}</h3>
              <p class="mt-3 text-ink-muted">{p.texte}</p>
            </li>
          ))
        }
      </ul>

      <h3 class="mt-24 text-2xl font-semibold text-teal-950">Ce qu’en disent les personnes accompagnées</h3>
      <ul class="mt-8 grid gap-5 md:grid-cols-2">
        {
          temoignages.map((t) => (
            <li class="reveal">
              <figure class="h-full rounded-2xl bg-paper-2 p-7">
                <blockquote class="text-lg text-ink">« {t.texte} »</blockquote>
                <figcaption class="mt-5 text-sm">
                  <span class="font-semibold text-teal-950">{t.nom}</span>
                  <span class="text-ink-muted">, {t.role}</span>
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
      <p class="mt-4 text-sm text-ink-muted">Avis publiés sur Google.</p>

      <h3 class="sr-only">Ils nous font confiance</h3>
      <ul class="mt-20 grid grid-cols-3 items-center gap-x-8 gap-y-10 sm:grid-cols-4 lg:grid-cols-6" aria-label="Clients et partenaires">
        {
          listeLogos.map((l) => (
            <li class="flex justify-center">
              <Image src={l.src} alt={l.nom} height={48} class="logo-partenaire h-10 w-auto max-w-[8rem] object-contain md:h-12" />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Votre guide -->
  <section class="bg-teal-950 py-24 text-paper md:py-32" aria-labelledby="guide-titre">
    <div class="container-sf grid items-center gap-12 md:grid-cols-2">
      <Image
        src={marieSommet}
        alt="Marie Jolly souriante au sommet, avec ses deux chiens, face aux Pyrénées"
        widths={[480, 800, 1100]}
        sizes="(min-width: 768px) 50vw, 100vw"
        quality={70}
        class="reveal aspect-[4/3] w-full rounded-2xl object-cover"
      />
      <div>
        <p class="eyebrow text-mint-300">Votre guide</p>
        <h2 id="guide-titre" class="mt-3 text-3xl font-semibold md:text-5xl">Marie Jolly, ingénieure industrielle avant d’être experte no-code</h2>
        <p class="mt-6 text-lg text-paper/85">
          Dix ans dans l’aéronautique et l’industrie, entre production, qualité et projets critiques. J’ai vu de près comment
          l’information se perd entre l’atelier, le bureau et le client. Aujourd’hui, je mets les outils no-code et l’IA au
          service de ce terrain, avec la rigueur que j’ai apprise là-bas.
        </p>
        <p class="mt-4 text-lg text-paper/85">
          En itinérance, j’ai appris à alléger mon sac sans perdre en confort. Je fais la même chose avec vos outils : on garde
          ce qui sert, on retire le superflu, et vos équipes avancent plus léger.
        </p>
        <a href="/a-propos" class="btn btn-ghost mt-8">Mon parcours</a>
      </div>
    </div>
  </section>

  <!-- Financement -->
  <section class="py-24" aria-labelledby="financement-titre">
    <div class="container-sf">
      <h2 id="financement-titre" class="text-2xl font-semibold text-teal-950 md:text-3xl">Certifications et financements</h2>
      <p class="mt-3 max-w-2xl text-ink-muted">Les formations peuvent être prises en charge selon votre situation. On regarde ensemble les options lors du premier échange.</p>
      <div class="mt-8"><Certifications /></div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-paper-2 py-24 md:py-32" aria-labelledby="faq-titre">
    <div class="container-sf grid gap-12 md:grid-cols-[1fr_1.6fr]">
      <div>
        <p class="eyebrow text-teal-700">Questions fréquentes</p>
        <h2 id="faq-titre" class="mt-3 text-3xl font-semibold text-teal-950 md:text-4xl">Avant de partir, on vérifie le matériel</h2>
      </div>
      <div class="divide-y divide-line border-y border-line">
        {
          faq.map((f) => (
            <details class="faq group py-2">
              <summary class="flex min-h-[44px] cursor-pointer list-none items-center justify-between gap-6 py-3 font-display text-lg font-medium text-teal-950">
                {f.q}
                <svg class="plus h-5 w-5 shrink-0 text-teal-700" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 4v12M4 10h12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
              </summary>
              <p class="pb-5 pr-10 text-ink-muted">{f.r}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA final -->
  <section class="py-24 md:py-32" aria-labelledby="cta-titre">
    <div class="container-sf">
      <div class="rounded-3xl bg-teal-900 px-7 py-14 text-center text-paper md:px-16 md:py-20">
        <h2 id="cta-titre" class="mx-auto max-w-3xl text-3xl font-semibold md:text-5xl">On regarde votre itinéraire ensemble ?</h2>
        <p class="mx-auto mt-5 max-w-xl text-lg text-paper/85">30 minutes en visio, gratuites et sans engagement. Vous repartez avec un premier avis honnête sur ce qui vaut la peine d’être simplifié.</p>
        <div class="mt-9 flex flex-wrap justify-center gap-3">
          <a href={SITE.calendly} class="btn btn-primary" rel="noopener">Réserver 30 min d’échange</a>
          <a href="/contact" class="btn btn-ghost">Écrire un message</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .carte { transition: transform 200ms var(--ease-out), box-shadow 200ms ease, border-color 200ms ease; }
  .fleche-carte { transition: transform 200ms var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .carte:hover { transform: translateY(-2px); box-shadow: 0 18px 40px -24px rgb(7 42 40 / 0.45); }
    .carte:hover .fleche-carte { transform: translateX(3px); }
  }
  .carte:active { transform: scale(0.99); }
  .logo-partenaire { filter: grayscale(1); opacity: 0.75; transition: filter 200ms ease, opacity 200ms ease; }
  @media (hover: hover) and (pointer: fine) {
    .logo-partenaire:hover { filter: none; opacity: 1; }
  }
  .plus { transition: transform 200ms var(--ease-out); }
  .faq[open] .plus { transform: rotate(45deg); }
  summary::-webkit-details-marker { display: none; }
</style>
